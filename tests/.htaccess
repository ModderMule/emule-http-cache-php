# The suite is a CLI tool. Reaching it over HTTP would run a 9.28 MB upload
# loop against the server, so it is never web-reachable. smoke.php also guards
# on PHP_SAPI, in case this file is not honoured.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
